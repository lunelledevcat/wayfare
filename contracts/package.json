    "generate": "hardhat run scripts/generate.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8"
  }
}
