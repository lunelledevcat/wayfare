# ---------------------------------------------------------------------------
# Wayfare environment variables. Copy to `.env` (repo root) and fill in.
# NEVER commit `.env` — it holds private keys.
# ---------------------------------------------------------------------------

# Key of the account that deploys the contracts on Fuji (needs test AVAX from
# https://core.app/tools/testnet-faucet/). Not needed for the local Hardhat network.
DEPLOYER_PRIVATE_KEY=

# Key used by the web server (POST /api/quote) to sign EIP-712 quotes.
# For the local network this can be left empty — the web server falls back to
# Hardhat account #1 key (well-known test key, never use it on a real network).
QUOTE_SIGNER_PRIVATE_KEY=

# Mnemonic whose accounts m/44'/60'/0'/0/0..4 become the demo operators
# (SkyThai Air, NorthStar Bus, Lanna Rail Express, BlueRiver Ferry, EastCoast Van).
# Empty = use Hardhat accounts #2..#6 (local only).
OPERATOR_MNEMONIC=

# Which chain the web app talks to: local | fuji
NEXT_PUBLIC_CHAIN=local
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8546

# Optional: Duffel API test token for live domestic flight offers.
DUFFEL_TEST_TOKEN=

# Optional: OSRM routing server (default https://router.project-osrm.org)
OSRM_URL=

# Optional: WalletConnect Cloud project id (RainbowKit mobile wallets)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: ElevenLabs text-to-speech for "Listen to trip summary" and weather alerts.
# Server-side only (used by POST /api/voice) — never prefix with NEXT_PUBLIC_.
# Empty = voice buttons are hidden; everything else works.
ELEVENLABS_API_KEY=
# Optional overrides (defaults: premade multilingual voice, eleven_multilingual_v2; Thai uses eleven_v3)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_MODEL_ID_TH=

# --- Google login (next-auth) -------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://<your-vercel-domain>/api/auth/callback/google
# Leave empty to run without login (the passenger app then stays open).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, e.g.  openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the site (http://localhost:3000 locally, your https domain on Vercel)
NEXTAUTH_URL=http://localhost:3000

# --- Cloudflare D1 (stores users who log in; called through the REST API) -------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token with permission: Account > D1 > Edit
CLOUDFLARE_API_TOKEN=
